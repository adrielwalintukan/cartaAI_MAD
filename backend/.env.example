# Salin ke .env lalu isi. JANGAN commit .env. Nilai di bawah hanya contoh/placeholder.
APP_ENV=development
LOG_LEVEL=INFO

SUPABASE_URL=https://wiyrblibtzufwejmspib.supabase.co
SUPABASE_SERVICE_ROLE_KEY=isi-service-role-key-dari-dashboard-supabase
SUPABASE_STORAGE_BUCKET=invitation-assets

GEMINI_API_KEY=isi-kunci-gemini
GEMINI_API_KEY_FALLBACK=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_SECONDS=240
GEMINI_MAX_OUTPUT_TOKENS=32768

MIDTRANS_SERVER_KEY=isi-server-key-sandbox-midtrans
MIDTRANS_IS_PRODUCTION=false
PREMIUM_PRICE_IDR=99000

WEB_BASE_URL=http://localhost:8081
PUBLIC_API_BASE_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:8081

FREE_GENERATION_LIMIT=3
PREMIUM_GENERATION_LIMIT=15
FREE_GUEST_LIMIT=50
FREE_ACTIVE_DAYS=30
PREMIUM_ACTIVE_DAYS=365
GALLERY_MAX_PHOTOS=10
CHAT_DAILY_LIMIT=20
MAX_INVITATIONS_PER_USER=5
MAX_IMAGE_BYTES=5242880
MAX_AUDIO_BYTES=10485760
JOB_STALE_AFTER_SECONDS=360
# Jumlah proxy tepercaya di depan app (Render: 1; bila ada CDN/WAF tambahan di depannya, naikkan). 0 = abaikan X-Forwarded-For
TRUSTED_PROXY_COUNT=1
