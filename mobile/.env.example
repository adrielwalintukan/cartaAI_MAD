# Semua variabel EXPO_PUBLIC_* tertanam di bundle klien: JANGAN isi rahasia (docs/04 §6.2).
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Anon/publishable key (aman publik, dilindungi RLS)
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# URL backend (lokal: http://localhost:8000; produksi: URL Render)
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
# Domain web, untuk menampilkan/membagikan link undangan (kosong di web = origin halaman)
EXPO_PUBLIC_WEB_BASE_URL=http://localhost:8081
